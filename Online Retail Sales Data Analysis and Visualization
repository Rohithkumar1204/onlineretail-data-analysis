
# Online Retail Sales Data Analysis and Visualization

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Step 1: Create sample retail sales dataset
data = {
    'Product': ['Laptop', 'Mobile', 'Headphones', 'Laptop',
                'Tablet', 'Mobile', 'Headphones', 'Tablet',
                'Laptop', 'Mobile'],
    'Category': ['Electronics'] * 10,
    'Quantity': [2, 5, 10, 1, 3, 4, 8, 2, 2, 6],
    'Price': [50000, 15000, 2000, 50000, 20000,
              15000, 2000, 20000, 50000, 15000],
    'Month': ['Jan', 'Jan', 'Jan', 'Feb', 'Feb',
              'Feb', 'Mar', 'Mar', 'Mar', 'Mar']
}

df = pd.DataFrame(data)

# Step 2: Display dataset
print("RETAIL SALES DATASET")
print(df)

# Step 3: Check and clean data
print("\nMissing Values:")
print(df.isnull().sum())

df.drop_duplicates(inplace=True)
df.fillna(0, inplace=True)

# Step 4: Calculate total sales
df['Total_Sales'] = df['Quantity'] * df['Price']

print("\nSales Data:")
print(df)

# Step 5: Total revenue
print("\nTotal Revenue:", df['Total_Sales'].sum())

# Step 6: Product-wise sales analysis
product_sales = df.groupby('Product')['Total_Sales'].sum()
print("\nProduct-wise Sales:")
print(product_sales)

# Step 7: Monthly sales analysis
monthly_sales = df.groupby('Month')['Total_Sales'].sum()
month_order = ['Jan', 'Feb', 'Mar']
monthly_sales = monthly_sales.reindex(month_order)

print("\nMonthly Sales:")
print(monthly_sales)

# Step 8: Product sales visualization
plt.figure(figsize=(8, 5))
product_sales.sort_values().plot(kind='bar')
plt.title('Product-wise Sales Analysis')
plt.xlabel('Product')
plt.ylabel('Sales Revenue (Rs.)')
plt.tight_layout()
plt.show()

# Step 9: Monthly sales visualization
plt.figure(figsize=(8, 5))
monthly_sales.plot(kind='line', marker='o')
plt.title('Monthly Sales Trend')
plt.xlabel('Month')
plt.ylabel('Sales Revenue (Rs.)')
plt.grid(True)
plt.tight_layout()
plt.show()

# Step 10: Sales distribution
plt.figure(figsize=(7, 5))
sns.histplot(df['Total_Sales'], bins=5, kde=True)
plt.title('Distribution of Transaction Sales')
plt.xlabel('Sales Revenue (Rs.)')
plt.tight_layout()
plt.show()

# Step 11: Conclusion
print("\nCONCLUSION")
print("Retail sales data was analyzed successfully.")
print("Product-wise and monthly sales charts were generated.")
print("Total revenue:", df['Total_Sales'].sum())
print("Top-selling product by revenue:",
      product_sales.idxmax())
